rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isClassMember(classId) {
      return signedIn() && userDoc().class_id == classId;
    }

    function isHealthOfficerOrTeacher() {
      return signedIn()
        && userDoc().role in ['class_health_officer', 'teacher'];
    }

    function canCloseCase(classId) {
      return isAdmin()
        || (isHealthOfficerOrTeacher() && isClassMember(classId));
    }

    function isGuestFixComment() {
      return request.resource.data.author_role == 'teacher'
        && request.resource.data.class_id is string
        && request.resource.data.inspection_id is string
        && request.resource.data.author_name is string
        && request.resource.data.content is string
        && request.resource.data.author_name.size() > 0
        && request.resource.data.author_name.size() <= 40
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 400
        && request.resource.data.keys().hasAll([
          'inspection_id', 'class_id', 'author_role', 'author_name',
          'content', 'created_at'
        ]);
    }

    match /classes/{classId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inspections/{inspectionId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (canCloseCase(resource.data.class_id)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status'])
            && request.resource.data.status == 'fixed')
        // 導師免登入銷案：只能把 status 改成 fixed
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status'])
            && request.resource.data.status == 'fixed'
            && resource.data.status in ['pending_fix', 'pass', 'fixed']);
    }

    match /inspection_items/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;
      // 登入帳號（身分一致）或免登入導師回報（僅累積留言，不覆寫）
      allow create: if isGuestFixComment()
        && (
          !signedIn()
          || (canCloseCase(request.resource.data.class_id)
              && request.resource.data.author_role == userDoc().role)
          || (isAdmin()
              && request.resource.data.author_role in ['teacher', 'class_health_officer'])
        );
      allow update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['display_name']));
      allow delete: if isAdmin();
    }
  }
}
