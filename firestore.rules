rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return userExists() && userDoc().role == 'admin';
    }

    function isClassMember(classId) {
      return userExists() && userDoc().class_id == classId;
    }

    function isHealthOfficerOrTeacher() {
      return userExists()
        && userDoc().role in ['class_health_officer', 'teacher'];
    }

    function canCloseCase(classId) {
      return isAdmin()
        || (isHealthOfficerOrTeacher() && isClassMember(classId));
    }

    function isStatusFixOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status'])
        && request.resource.data.status == 'fixed'
        && resource.data.status in ['pending_fix', 'pass', 'fixed'];
    }

    function isGuestFixComment() {
      return request.resource.data.author_role == 'teacher'
        && request.resource.data.class_id is string
        && request.resource.data.inspection_id is string
        && request.resource.data.author_name is string
        && request.resource.data.content is string
        && request.resource.data.author_name.size() > 0
        && request.resource.data.author_name.size() <= 40
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 400
        && request.resource.data.keys().hasAll([
          'inspection_id', 'class_id', 'author_role', 'author_name',
          'content', 'created_at'
        ]);
    }

    match /classes/{classId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inspections/{inspectionId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // 先允許「只改 status→fixed」（含已登入巡察帳號），避免 users 讀取失敗擋掉整條規則
      allow update: if isStatusFixOnly() || isAdmin();
    }

    match /inspection_items/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;
      // 免登入／已登入皆可累積導師改善回報；不覆寫舊留言
      allow create: if isGuestFixComment()
        || (canCloseCase(request.resource.data.class_id)
            && request.resource.data.author_role == userDoc().role
            && request.resource.data.keys().hasAll([
              'inspection_id', 'class_id', 'author_role', 'author_name',
              'content', 'created_at'
            ]));
      allow update, delete: if isAdmin();
    }

    function isGuestSupplyRequest() {
      return request.resource.data.class_id is string
        && request.resource.data.item_id is string
        && request.resource.data.item_label is string
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 1
        && request.resource.data.quantity <= 99
        && request.resource.data.applicant_name is string
        && request.resource.data.applicant_name.size() > 0
        && request.resource.data.applicant_name.size() <= 40
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200
        && request.resource.data.status == 'pending'
        && request.resource.data.created_at is string
        && request.resource.data.keys().hasAll([
          'class_id', 'item_id', 'item_label', 'quantity',
          'applicant_name', 'note', 'status', 'created_at'
        ]);
    }

    match /supply_requests/{requestId} {
      allow read: if true;
      allow create: if isGuestSupplyRequest();
      allow update, delete: if isAdmin();
    }

    function isTelegramBinding() {
      return request.resource.data.chat_id is string
        && request.resource.data.chat_id.size() > 0
        && request.resource.data.chat_id.size() <= 32
        && request.resource.data.role in ['staff', 'teacher']
        && request.resource.data.class_id is string
        && request.resource.data.class_id.size() <= 32
        && request.resource.data.active is bool
        && request.resource.data.created_at is string
        && request.resource.data.keys().hasAll([
          'chat_id', 'role', 'class_id', 'active', 'created_at'
        ]);
    }

    match /telegram_bindings/{id} {
      allow read: if true;
      allow create: if isTelegramBinding();
      allow update: if isTelegramBinding()
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['active', 'updated_at']);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['display_name']));
      allow delete: if isAdmin();
    }

    match /menus/{menuId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    function isGuestLunchReport() {
      return request.resource.data.kind in ['feedback', 'portion', 'leftover', 'safety']
        && request.resource.data.class_id is string
        && request.resource.data.class_id.size() <= 32
        && request.resource.data.class_name is string
        && request.resource.data.class_name.size() > 0
        && request.resource.data.class_name.size() <= 40
        && request.resource.data.status == 'pending'
        && request.resource.data.created_at is string
        && request.resource.data.source is string
        && request.resource.data.keys().hasAll([
          'kind', 'class_id', 'class_name', 'status', 'source', 'created_at'
        ]);
    }

    match /lunch_reports/{reportId} {
      allow read: if true;
      allow create: if isGuestLunchReport();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updated_at']);
      allow delete: if isAdmin();
    }
  }
}
