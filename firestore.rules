rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isClassMember(classId) {
      return signedIn() && userDoc().class_id == classId;
    }

    function isHealthOfficerOrTeacher() {
      return signedIn()
        && userDoc().role in ['class_health_officer', 'teacher'];
    }

    function canCloseCase(classId) {
      return isAdmin()
        || (isHealthOfficerOrTeacher() && isClassMember(classId));
    }

    match /classes/{classId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inspections/{inspectionId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // 組長可完整更新；衛生股長／導師可將同班巡檢銷案（status → fixed）
      allow update: if isAdmin()
        || (canCloseCase(resource.data.class_id)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status'])
            && request.resource.data.status == 'fixed');
    }

    match /inspection_items/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if canCloseCase(request.resource.data.class_id)
        && request.resource.data.keys().hasAll([
          'inspection_id', 'class_id', 'author_role', 'author_name', 'content', 'created_at'
        ]);
      allow update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role != 'admin';
      allow update: if isAdmin()
        || (signedIn()
            && request.auth.uid == uid
            && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }
  }
}
